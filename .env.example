# AgenticMedNorm-IN optional environment variables.
# Values here are placeholders only. Do not commit real credentials.

AGENTICMEDNORM_DATA_ROOT=./data
AGENTICMEDNORM_CACHE_ROOT=./cache
AGENTICMEDNORM_OUTPUT_ROOT=./outputs

# Optional paid/online annotation path. Not required for public smoke tests.
OPENAI_API_KEY=
ANNOTATION_API_KEY=

# Optional local model services for evaluation experiments.
OLLAMA_HOST=http://127.0.0.1:11434

# Optional external terminology/resource services.
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
