# =============================================================================
# ClinDoc-Bench-In  —  .gitignore
# =============================================================================
# Philosophy: Track only reusable code, schemas, prompts, configs, anonymised
# manifests, and final paper-facing summaries. Never track raw PHI data,
# model outputs with patient text, large binaries, or server-specific state.
# =============================================================================

# ---------------------------------------------------------------------------
# Private/PHI data (NEVER commit)
# ---------------------------------------------------------------------------
data/images/
data/raw/
data/ground_truth/
data/outputs/
data/normalized/
data/enhanced_outputs/
data/baseline_evaluation/
data/demo_synthea_bundle.json
data/prescriptions/
data/raw_ground_truths/
raw_ground_truths/
prescriptions/
prescription_pipeline_jbhi_ieee/raw/
prescription_pipeline_jbhi_ieee/anonymized/
prescription_pipeline_jbhi_ieee/ground_truths_json/
*.pdf
!paper_artifacts/figures/**/*.pdf

# ---------------------------------------------------------------------------
# Dataset internal mapping (contains internal IDs)
# ---------------------------------------------------------------------------
dataset/llm_audited_150/crosswalk.json

# ---------------------------------------------------------------------------
# Benchmark outputs (large, run-specific, contain patient text in raw form)
# ---------------------------------------------------------------------------
benchmark_outputs/
outputs/
exports/*.tar.gz
exports/*.gz
derived/context_bundles.jsonl
state/pipeline_state.sqlite
state/pipeline_state.sqlite-*

# ---------------------------------------------------------------------------
# Model caches and weights
# ---------------------------------------------------------------------------
cache/
.cache/
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
models/

# ---------------------------------------------------------------------------
# Conda / venv / pip
# ---------------------------------------------------------------------------
.venv/
.venv*/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg

# ---------------------------------------------------------------------------
# Logs (runtime logs, not docs)
# ---------------------------------------------------------------------------
logs/*.log
logs/*.pid
*.log

# ---------------------------------------------------------------------------
# Secrets and environment files
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials/
credentials.*
secrets/
*secret*
*token*

# ---------------------------------------------------------------------------
# Server-specific scratch directories
# ---------------------------------------------------------------------------
server1_copy/
server2_copy/
configs/servers/
prescription_pipeline/outputs/
prescription_pipeline/logs/
prescription_pipeline/prescriptions/
prescription_pipeline/raw_ground_truths/
prescription_pipeline/.pytest_cache/

# ---------------------------------------------------------------------------
# Stale root-level planning artefacts (not part of the clean repo)
